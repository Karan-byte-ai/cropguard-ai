# ==============================================================================
# CropGuard AI Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with PostGIS and pgvector)
POSTGRES_USER=cropguard
POSTGRES_PASSWORD=cropguard_secret_pwd
POSTGRES_DB=cropguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cropguard:cropguard_secret_pwd@localhost:5432/cropguard

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cropguard-scans
S3_REGION=us-east-1
S3_USE_SSL=false

# Machine Learning & Inference Service
INFERENCE_SERVICE_URL=http://localhost:8001
MODEL_PATH=apps/inference/models/cropguard_efficientnet_b0_v1.onnx
LEAF_VALIDATOR_PATH=apps/inference/models/leaf_validator_v1.onnx
MODEL_VERSION=v1.3.0

# External APIs
NEWS_API_KEY=your_news_api_key_here
TRANSLATE_API_KEY=your_translate_api_key_here
SENTRY_DSN=

# CORS & Domain Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
