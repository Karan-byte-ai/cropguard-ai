{
  "name": "cropguard-ai",
  "version": "1.0.0",
  "description": "Plant Disease Identification and Awareness Platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "lint:web": "cd apps/web && npm run lint",
    "type-check:web": "cd apps/web && npm run type-check",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f"
  },
  "keywords": [
    "cropguard",
    "agriculture",
    "plant-disease",
    "ai",
    "fastapi",
    "nextjs",
    "onnx"
  ],
  "author": "Google DeepMind & CropGuard Team",
  "license": "Apache-2.0"
}
